{
  "name": "lilywaist-line",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:error": "eslint . --quiet",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:gen:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > init.sql",
